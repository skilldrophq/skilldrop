---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  favicon?: string;
  socialImage?: string;
  themeColor?: string;
}

const {
  title,
  description,
  bodyClass,
  favicon = "/favicon.svg",
  socialImage = "/social-card.svg",
  themeColor = "#f7f1e8",
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const analyticsDebugSite = import.meta.env.DEV ? "skilldrop.dev" : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=Newsreader:opsz,wght@6..72,400..700&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(socialImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(socialImage, Astro.site)} />
    <script
      is:inline
      defer
      src="https://assets.onedollarstats.com/stonks.js"
      data-debug={analyticsDebugSite}
    ></script>
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
