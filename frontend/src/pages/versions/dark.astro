---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/dark.css";

const installCommand = "curl -fsSL https://getsk.dev/install.sh | sh";
const shareCommand = "sk share ~/.claude/skills/review-pr";
const snapshotUrl = "skilldrop.dev/s/sk_7fx2ka";
---

<BaseLayout
  title="Skilldrop — Your skill, on their machine"
  description="Send a local agent skill as an immutable, inspectable snapshot. One command, no repository required."
  bodyClass="dark-body"
  favicon="/favicon-dark.svg"
  socialImage="/social-card-dark.svg"
  themeColor="#11130f"
>
  <a class="d-skip" href="#content">Skip to content</a>

  <div class="dark-site">
    <header class="d-header d-wrap">
      <a class="d-brand" href="/" aria-label="Skilldrop home">
        <svg viewBox="0 0 38 38" aria-hidden="true">
          <path d="M5 12h28v21H5z"></path>
          <path d="M19 3v22m0 0 7-7m-7 7-7-7"></path>
        </svg>
        <span>skilldrop</span>
      </a>

      <nav class="d-nav" aria-label="Primary navigation">
        <a href="#protocol">Protocol</a>
        <a href="#trust">Trust</a>
      </nav>
    </header>

    <main id="content">
      <section class="d-hero d-wrap" aria-labelledby="d-hero-title">
        <div class="d-hero-index" aria-hidden="true">
          <span>SK / 01</span>
          <span>TRANSFER<br />PROTOCOL</span>
        </div>

        <div class="d-hero-main">
          <p class="d-kicker"><span></span> Local skill detected</p>
          <h1 id="d-hero-title">
            Your skill.<br />
            <em>Their machine.</em>
          </h1>
          <div class="d-hero-bottom">
            <p>Turn the exact agent skill on your disk into a link someone else can inspect and install.</p>
            <a class="d-arrow-link" href="#install">Get the CLI <span aria-hidden="true">↘</span></a>
          </div>
        </div>

        <div class="d-stamp" aria-hidden="true">
          <span>NO</span><strong>GIT</strong><small>REQUIRED</small>
        </div>
      </section>

      <section class="d-command-stage" aria-label="Skill transfer command demonstration">
        <div class="d-wrap d-stage-grid">
          <div class="d-origin-label"><span>A</span> YOUR TERMINAL</div>

          <div class="d-terminal">
            <div class="d-terminal-top">
              <span>~/skills/review-pr</span>
              <span class="d-online"><i></i> READY</span>
            </div>
            <div class="d-terminal-command">
              <span class="d-prompt">$</span>
              <code>{shareCommand}</code>
              <button class="d-copy" type="button" data-copy={shareCommand} aria-label="Copy share command">
                <span>copy</span>
                <svg viewBox="0 0 18 18" aria-hidden="true"><rect x="6" y="5" width="8" height="9"></rect><path d="M4 11H3V3h8v1"></path></svg>
              </button>
            </div>
            <div class="d-terminal-output">
              <p><span>01</span> validating <strong>SKILL.md</strong></p>
              <p><span>02</span> sealing <strong>2 files · 4.9 KB</strong></p>
              <p><span>03</span> uploaded <a href="#protocol">{snapshotUrl}</a></p>
            </div>
          </div>

          <div class="d-transfer-mark" aria-hidden="true">
            <span>SNAPSHOT IN TRANSIT</span>
            <div><i></i><i></i><i></i><b>→</b></div>
          </div>

          <div class="d-receipt">
            <div class="d-receipt-head"><span>TRANSFER RECEIPT</span><strong>VERIFIED</strong></div>
            <dl>
              <div><dt>NAME</dt><dd>review-pr</dd></div>
              <div><dt>TYPE</dt><dd>immutable snapshot</dd></div>
              <div><dt>EXPIRES</dt><dd>90 days</dd></div>
              <div><dt>SHA-256</dt><dd>5af1…e91c</dd></div>
            </dl>
            <div class="d-barcode" aria-hidden="true"></div>
          </div>
        </div>
      </section>

      <section class="d-statement d-wrap" aria-labelledby="statement-title">
        <span class="d-section-label">WHY SKILLDROP</span>
        <h2 id="statement-title">A transfer layer.<br /><i>Nothing more.</i></h2>
        <div class="d-statement-copy">
          <p>Skills often need to move before they need to become packages.</p>
          <p>Skilldrop sends the folder you already have—without a repository, release, account, or publishing workflow.</p>
        </div>
      </section>

      <section class="d-protocol" id="protocol" aria-labelledby="protocol-title">
        <div class="d-wrap">
          <div class="d-protocol-head">
            <span class="d-section-label">THE PROTOCOL</span>
            <h2 id="protocol-title">Disk → link → disk.</h2>
          </div>

          <ol class="d-protocol-list">
            <li>
              <span class="d-step-num">01</span>
              <div><small>PACK</small><h3>Share the folder.</h3></div>
              <p>The CLI validates the skill, blocks unsafe paths, and packages every regular file.</p>
              <code>sk share review-pr</code>
            </li>
            <li>
              <span class="d-step-num">02</span>
              <div><small>CHECK</small><h3>Inspect the link.</h3></div>
              <p>The recipient sees the manifest, contents, checksum, and executable warnings first.</p>
              <code>sk inspect {snapshotUrl}</code>
            </li>
            <li>
              <span class="d-step-num">03</span>
              <div><small>DROP</small><h3>Install the snapshot.</h3></div>
              <p>The verified folder lands in the selected agent directory. Nothing inside it is executed.</p>
              <code>sk install {snapshotUrl}</code>
            </li>
          </ol>
        </div>
      </section>

      <section class="d-trust d-wrap" id="trust" aria-labelledby="trust-title">
        <div class="d-trust-title">
          <span class="d-section-label">TRUST THE CONTENTS</span>
          <h2 id="trust-title">Open the box<br />before you keep it.</h2>
        </div>

        <div class="d-trust-ledger">
          <div><span>01</span><strong>Immutable by default</strong><p>Every share creates a new snapshot. Existing links never change underneath you.</p></div>
          <div><span>02</span><strong>Every file disclosed</strong><p>Names, sizes, checksums, and executable flags are visible before installation.</p></div>
          <div><span>03</span><strong>Scripts stay still</strong><p>Skilldrop copies skill files. It never runs scripts contained inside them.</p></div>
        </div>
      </section>

      <section class="d-boundary" aria-label="Product positioning">
        <div class="d-wrap d-boundary-grid">
          <p>Discovery asks</p>
          <blockquote>“Which skill should I install?”</blockquote>
          <span aria-hidden="true">≠</span>
          <p>Skilldrop asks</p>
          <blockquote>“How do I send you this one?”</blockquote>
        </div>
      </section>

      <section class="d-install d-wrap" id="install" aria-labelledby="install-title">
        <div class="d-install-copy">
          <span class="d-section-label">GET SK</span>
          <h2 id="install-title">Make skills<br />move.</h2>
          <p>Install the <code>sk</code> CLI and send your first local skill.</p>
        </div>

        <div class="d-install-box">
          <div class="d-install-meta"><span>INSTALL.SH</span><span>GETSK.DEV</span></div>
          <code><span>$</span> {installCommand}</code>
          <button class="d-install-copy" type="button" data-copy={installCommand}>
            <span>Copy install command</span><b aria-hidden="true">↗</b>
          </button>
        </div>
      </section>
    </main>

    <footer class="d-footer d-wrap">
      <a class="d-brand" href="/" aria-label="Skilldrop home">
        <svg viewBox="0 0 38 38" aria-hidden="true"><path d="M5 12h28v21H5z"></path><path d="M19 3v22m0 0 7-7m-7 7-7-7"></path></svg>
        <span>skilldrop</span>
      </a>
      <p>Send skills. Skip repos.</p>
      <div><a href="#protocol">Protocol</a><a href="#trust">Trust</a></div>
      <small>© {new Date().getFullYear()} · SKILLDROP.DEV</small>
    </footer>

    <div class="d-toast" role="status" aria-live="polite" aria-atomic="true">Command copied</div>
  </div>

  <script>
    const toast = document.querySelector<HTMLElement>(".d-toast");
    let timeout: number | undefined;

    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const value = button.dataset.copy;
        if (!value) return;

        try {
          await navigator.clipboard.writeText(value);
          button.classList.add("is-copied");
          if (toast) {
            toast.classList.add("is-visible");
            window.clearTimeout(timeout);
            timeout = window.setTimeout(() => toast.classList.remove("is-visible"), 1600);
          }
          window.setTimeout(() => button.classList.remove("is-copied"), 1600);
        } catch {
          window.prompt("Copy this command:", value);
        }
      });
    });
  </script>
</BaseLayout>
