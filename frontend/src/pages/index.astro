---
import BaseLayout from "../layouts/BaseLayout.astro";

const installCommand = "curl -fsSL https://getsk.dev/install.sh | sh";
const shareCommand = "sk share ~/.claude/skills/review-pr";
---

<BaseLayout
  title="Skilldrop — Send agent skills, not repositories"
  description="Turn any local agent skill into an immutable, inspectable link. No repository, account, or publishing workflow required."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header wrap">
    <a class="brand" href="/" aria-label="Skilldrop home">
      <svg class="brand-mark" viewBox="0 0 34 34" aria-hidden="true">
        <path d="M5 8.5h24v17H5z" fill="none" stroke="currentColor" stroke-width="2.2"></path>
        <path d="M17 3v16m0 0 5-5m-5 5-5-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"></path>
      </svg>
      <span>Skilldrop</span>
    </a>

    <nav aria-label="Primary navigation">
      <a href="#how-it-works">How it works</a>
      <a href="#safety">Safety</a>
      <a class="nav-install" href="#install">Install <span aria-hidden="true">↘</span></a>
    </nav>
  </header>

  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow"><span class="pulse" aria-hidden="true"></span> Agent skill transfer</div>
        <h1 id="hero-title">Send the skill.<br /><em>Skip the repo.</em></h1>
        <p class="hero-lede">
          Turn any local agent skill into an immutable, inspectable link. From your terminal to theirs in one command.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="#install">Install the CLI <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="#how-it-works">See the 20-second workflow <span aria-hidden="true">→</span></a>
        </div>

        <p class="hero-note">No account · No Git required · Snapshots expire automatically</p>
      </div>

      <div class="transfer-demo" aria-label="Terminal demonstration of sharing a skill">
        <div class="terminal terminal-source">
          <div class="terminal-bar">
            <span class="terminal-label">your machine</span>
            <span class="terminal-status">local</span>
          </div>
          <div class="terminal-body">
            <p class="path">~/.claude/skills/review-pr</p>
            <div class="file-row"><span>◇</span><strong>SKILL.md</strong><span>3.2 KB</span></div>
            <div class="file-row"><span>└</span><span>references/checklist.md</span><span>1.7 KB</span></div>
            <div class="command-line"><span class="prompt">$</span> <span class="typed">{shareCommand}</span><span class="cursor" aria-hidden="true"></span></div>
          </div>
        </div>

        <div class="transfer-path" aria-hidden="true">
          <span class="path-line"></span>
          <span class="snapshot-chip">sealed snapshot</span>
          <svg viewBox="0 0 28 28"><path d="M4 14h18m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
        </div>

        <div class="terminal terminal-result">
          <div class="terminal-bar">
            <span class="terminal-label">skilldrop.io</span>
            <span class="terminal-status live"><i></i> ready</span>
          </div>
          <div class="terminal-body result-body">
            <div class="result-heading"><span class="check">✓</span><div><strong>review-pr</strong><small>2 files · 4.9 KB</small></div></div>
            <a href="#how-it-works" class="snapshot-url">skilldrop.io/s/sk_7fx2ka</a>
            <div class="checksum"><span>SHA-256</span><code>5af1…e91c</code></div>
          </div>
        </div>
      </div>
    </section>

    <section class="ticker" aria-label="Product principles">
      <div class="ticker-track">
        <span>local skill</span><b>→</b><span>immutable snapshot</span><b>→</b><span>inspectable link</span><b>→</b><span>installed anywhere</span>
      </div>
    </section>

    <section class="workflow wrap" id="how-it-works" aria-labelledby="workflow-title">
      <div class="section-intro">
        <span class="section-number">01 / Workflow</span>
        <h2 id="workflow-title">One skill.<br />Two terminals.</h2>
        <p>Skilldrop transfers what you already made. It doesn’t turn it into a package or ask you to maintain another project.</p>
      </div>

      <div class="workflow-steps">
        <article class="workflow-step">
          <div class="step-meta"><span>01</span><span>Sender</span></div>
          <h3>Share the folder you’re using.</h3>
          <p>Pass a skill name or path. Skilldrop validates the files, creates a fresh snapshot, and returns a link.</p>
          <div class="code-block" data-copy-root>
            <code><span class="code-prompt">$</span> sk share review-pr</code>
            <button class="copy-button" type="button" data-copy="sk share review-pr" aria-label="Copy share command">
              <span>Copy</span>
              <svg viewBox="0 0 18 18" aria-hidden="true"><rect x="6" y="5" width="8" height="9" rx="1"></rect><path d="M4 11H3V3h8v1"></path></svg>
            </button>
          </div>
        </article>

        <article class="workflow-step shifted">
          <div class="step-meta"><span>02</span><span>Recipient</span></div>
          <h3>Inspect before it touches your setup.</h3>
          <p>See every file, checksum, executable warning, target agent, and destination before installing.</p>
          <div class="inspection">
            <div><span class="inspection-icon safe">✓</span><span>SKILL.md</span><small>verified</small></div>
            <div><span class="inspection-icon">⌁</span><span>2 regular files</span><small>4.9 KB</small></div>
            <div><span class="inspection-icon">#</span><span>Bundle checksum</span><small>matches</small></div>
            <div><span class="inspection-icon">↯</span><span>Executable scripts</span><small>none</small></div>
          </div>
        </article>

        <article class="workflow-step">
          <div class="step-meta"><span>03</span><span>Installed</span></div>
          <h3>Drop it into the right agent.</h3>
          <p>The CLI detects supported agents and puts the verified skill where it belongs. Scripts are never run automatically.</p>
          <div class="code-block" data-copy-root>
            <code><span class="code-prompt">$</span> sk install skilldrop.io/s/sk_7fx2ka</code>
            <button class="copy-button" type="button" data-copy="sk install skilldrop.io/s/sk_7fx2ka" aria-label="Copy install command">
              <span>Copy</span>
              <svg viewBox="0 0 18 18" aria-hidden="true"><rect x="6" y="5" width="8" height="9" rx="1"></rect><path d="M4 11H3V3h8v1"></path></svg>
            </button>
          </div>
          <div class="agent-targets" aria-label="Supported agent destinations">
            <span>Claude Code</span><span>Codex</span><span>more soon</span>
          </div>
        </article>
      </div>
    </section>

    <section class="boundary wrap" aria-labelledby="boundary-title">
      <div class="boundary-statement">
        <span class="section-number">02 / The boundary</span>
        <h2 id="boundary-title">Not another<br /><em>marketplace.</em></h2>
      </div>
      <div class="boundary-compare">
        <div class="compare-row muted"><span>Discovery platforms</span><strong>“Which skill should I install?”</strong></div>
        <div class="compare-divider"><span>versus</span></div>
        <div class="compare-row active"><span>Skilldrop</span><strong>“How do I send you this skill?”</strong></div>
      </div>
    </section>

    <section class="safety" id="safety" aria-labelledby="safety-title">
      <div class="wrap safety-inner">
        <div class="safety-copy">
          <span class="section-number light">03 / Built for trust</span>
          <h2 id="safety-title">A link you can<br />look inside.</h2>
          <p>Every share is a sealed, immutable snapshot. Skilldrop shows its contents before installation and refuses unsafe paths or symlinks.</p>
        </div>

        <div class="manifest-card">
          <div class="manifest-top"><span>skilldrop.manifest</span><span>verified ✓</span></div>
          <dl>
            <div><dt>Snapshot</dt><dd>sk_7fx2ka</dd></div>
            <div><dt>Created</dt><dd>just now</dd></div>
            <div><dt>Expires</dt><dd>in 90 days</dd></div>
            <div><dt>Contents</dt><dd>2 regular files</dd></div>
            <div><dt>Symlinks</dt><dd class="good">rejected</dd></div>
            <div><dt>Auto-execution</dt><dd class="good">never</dd></div>
          </dl>
          <div class="seal" aria-hidden="true"><span>SHA</span><strong>256</strong><small>sealed</small></div>
        </div>
      </div>
    </section>

    <section class="install wrap" id="install" aria-labelledby="install-title">
      <div class="install-heading">
        <span class="section-number">04 / Start here</span>
        <h2 id="install-title">Ready in one line.</h2>
        <p>Install <code>sk</code>, then share any skill folder from your terminal.</p>
      </div>

      <div class="install-command" data-copy-root>
        <div class="install-shell"><span>terminal</span><i></i></div>
        <code><span class="code-prompt">$</span> {installCommand}</code>
        <button class="copy-button copy-large" type="button" data-copy={installCommand} aria-label="Copy CLI installation command">
          <span>Copy command</span>
          <svg viewBox="0 0 18 18" aria-hidden="true"><rect x="6" y="5" width="8" height="9" rx="1"></rect><path d="M4 11H3V3h8v1"></path></svg>
        </button>
      </div>
      <p class="install-domain">Installation script served from <a href="https://getsk.dev/install.sh">getsk.dev/install.sh</a></p>
    </section>
  </main>

  <footer>
    <div class="wrap footer-inner">
      <a class="brand footer-brand" href="/" aria-label="Skilldrop home">
        <svg class="brand-mark" viewBox="0 0 34 34" aria-hidden="true"><path d="M5 8.5h24v17H5z" fill="none" stroke="currentColor" stroke-width="2.2"></path><path d="M17 3v16m0 0 5-5m-5 5-5-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"></path></svg>
        <span>Skilldrop</span>
      </a>
      <p>Move skills, not setup instructions.</p>
      <div class="footer-links"><a href="#how-it-works">How it works</a><a href="#safety">Safety</a><a href="https://getsk.dev/install.sh">Install</a></div>
      <p class="copyright">© {new Date().getFullYear()} Skilldrop · skilldrop.io</p>
    </div>
  </footer>

  <div class="copy-toast" role="status" aria-live="polite" aria-atomic="true">Copied to clipboard</div>

  <script>
    const toast = document.querySelector<HTMLElement>(".copy-toast");
    let toastTimeout: number | undefined;

    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const value = button.dataset.copy;
        if (!value) return;

        try {
          await navigator.clipboard.writeText(value);
          button.classList.add("copied");
          const label = button.querySelector("span");
          const originalLabel = label?.textContent;
          if (label) label.textContent = "Copied";
          if (toast) {
            toast.classList.add("visible");
            window.clearTimeout(toastTimeout);
            toastTimeout = window.setTimeout(() => toast.classList.remove("visible"), 1800);
          }
          window.setTimeout(() => {
            button.classList.remove("copied");
            if (label && originalLabel) label.textContent = originalLabel;
          }, 1800);
        } catch {
          window.prompt("Copy this command:", value);
        }
      });
    });
  </script>
</BaseLayout>
