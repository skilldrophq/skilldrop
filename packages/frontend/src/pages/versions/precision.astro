---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/precision.css";

const installCommand = "curl -fsSL https://getsk.dev/install.sh | sh";
const shareCommand = "sk share ~/.claude/skills/review-pr";
const inspectCommand = "sk inspect https://skilldrop.dev/s/PL1mY4-";
const installMethods = [
  { label: "script", command: installCommand },
  { label: "npm", command: "npm install --global @skilldrophq/cli" },
  { label: "homebrew", command: "brew install skilldrophq/tap/skilldrop" },
];
const agents = ["Claude Code", "Codex", "Cursor", "Gemini CLI", "GitHub Copilot", "OpenCode", "Goose", "OpenHands"];
const isDesignPreview = Astro.url.pathname.startsWith("/versions/");
const softwareSchema = {
  "@type": "SoftwareApplication",
  "@id": "https://skilldrop.dev/#software",
  name: "Skilldrop",
  alternateName: "sk",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS, Windows",
  url: "https://skilldrop.dev/",
  downloadUrl: "https://getsk.dev/install.sh",
  description: "A CLI for sharing local agent skills as immutable, inspectable snapshots without requiring a Git repository.",
};
---

<BaseLayout
  title="Share a local Agent Skill with one link — Skilldrop"
  description="Share a local Claude Code, Codex, or Agent Skill as an immutable 7-day link. No Git repository or account. Inspect every file before installing."
  bodyClass="td-body"
  themeColor="#0A0B0D"
  favicon="/favicon-dark.svg"
  socialImage="/social-card-dark.svg"
  robots={isDesignPreview ? "noindex, nofollow" : undefined}
  structuredData={softwareSchema}
>
  <a class="td-skip" href="#main">Skip to content</a>

  <header class="td-header">
    <div class="td-wrap td-nav-shell">
      <a class="td-brand" href="/" aria-label="Skilldrop home">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5.5 9.5h21v16h-21z"></path><path d="M16 3.5v14m0 0 5-5m-5 5-5-5"></path></svg>
        <span>skilldrop</span><code>open source</code>
      </a>
      <nav class="td-nav" aria-label="Primary navigation">
        <a href="/docs/">Docs</a>
        <a href="/cli/">CLI</a>
        <a href="/security/">Security</a>
        <a class="td-nav-source" href="https://github.com/skilldrophq/skilldrop">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </header>

  <main id="main" data-s-view-props="landing_variant=handoff_v1">
    <section class="td-hero td-wrap" aria-labelledby="hero-title">
      <div class="td-hero-copy">
        <p class="td-status"><span></span> A transfer layer for Agent Skills</p>
        <h1 id="hero-title">Share a local agent skill <span>in one command.</span></h1>
        <p class="td-lede">Turn any Claude Code, Codex, or compatible skill folder into an immutable link that expires after 7 days. Your teammate can inspect every file, then install it—no repo, account, or marketplace.</p>
        <div class="td-hero-install" aria-label="Install Skilldrop">
          <div><span class="td-prompt" aria-hidden="true">$</span><code>{installCommand}</code></div>
          <button type="button" data-copy={installCommand} data-s-event="install_command_copy" data-s-event-props="command_variant=script"><span>Copy install command</span><b aria-hidden="true">✓ Copied</b></button>
        </div>
        <div class="td-hero-actions">
          <a class="td-script-link" href="https://getsk.dev/install.sh">View script <span aria-hidden="true">↗</span></a>
          <a class="td-button td-button-secondary" href="/example-snapshot/" data-s-event="example_snapshot_open">View an example snapshot</a>
        </div>
        <p class="td-trust-line">Open source <span>·</span> nothing executes automatically <span>·</span> unlisted links expire after 7 days</p>
      </div>

      <div class="td-frame td-hero-frame">
        <figure class="td-surface td-terminal" aria-label="Terminal session sharing a local skill">
          <figcaption class="td-chrome">
            <span class="td-tab">share · zsh</span>
            <span class="td-chrome-path">~/skills/review-pr</span>
            <button type="button" class="td-icon-button" data-copy={shareCommand} aria-label="Copy share command">
              <svg class="td-copy-icon" viewBox="0 0 18 18" aria-hidden="true"><rect x="6" y="5" width="8" height="9"></rect><path d="M4 11H3V3h8v1"></path></svg>
              <svg class="td-check-icon" viewBox="0 0 18 18" aria-hidden="true"><path d="m3.5 9 3.3 3.3 7.7-7.6"></path></svg>
            </button>
          </figcaption>
          <div class="td-terminal-body" role="region" aria-label="Scrollable terminal output" tabindex="0">
            <div class="td-code-line"><span class="td-line-no">1</span><code><span class="td-prompt">$</span> sk share ~/.claude/skills/review-pr</code></div>
            <div class="td-code-line"><span class="td-line-no">2</span><code class="td-comment">Validating ~/.claude/skills/review-pr…</code></div>
            <div class="td-code-line"><span class="td-line-no">3</span><code><span class="td-success">Shared</span> review-pr</code></div>
            <div class="td-code-line td-marked-line"><span class="td-line-no">4</span><code><a href="#inspect">https://skilldrop.dev/s/PL1mY4-</a></code></div>
            <div class="td-code-line"><span class="td-line-no">5</span><code class="td-dim">Install with: sk install https://skilldrop.dev/s/PL1mY4-</code></div>
            <div class="td-code-line"><span class="td-line-no">6</span><code> </code></div>
            <div class="td-code-line"><span class="td-line-no">7</span><code><span class="td-prompt">$</span> sk inspect https://skilldrop.dev/s/PL1mY4-</code></div>
            <div class="td-code-line"><span class="td-line-no">8</span><code>Snapshot <span class="td-function">PL1mY4-</span></code></div>
            <div class="td-code-line"><span class="td-line-no">9</span><code>  skill: review-pr</code></div>
            <div class="td-code-line"><span class="td-line-no">10</span><code>  bundle: 4.9 KiB <span class="td-dim">(5018 bytes)</span></code></div>
            <div class="td-code-line"><span class="td-line-no">11</span><code>  integrity: <span class="td-success">verified</span></code></div>
            <div class="td-code-line"><span class="td-line-no">12</span><code>  expires: <span class="td-number">Aug 29, 2026 at 14:32 UTC</span></code></div>
            <div class="td-code-line"><span class="td-line-no">13</span><code> </code></div>
            <div class="td-code-line"><span class="td-line-no">14</span><code><span class="td-prompt">$</span> sk install PL1mY4- --agent codex</code></div>
            <div class="td-code-line td-marked-line"><span class="td-line-no">15</span><code><span class="td-success">Installed</span> review-pr → .agents/skills/review-pr</code></div>
          </div>
          <div class="td-terminal-foot"><span><i></i> snapshot online</span><span>exit 0</span></div>
        </figure>
      </div>
    </section>

    <section class="td-quickstart" aria-label="Product boundary">
      <div class="td-wrap td-boundary-line">
        <span class="td-section-index">00 / the handoff</span>
        <p><strong>One local folder.</strong> One inspectable link. Seven days to install it.</p>
        <code>not a registry → not a marketplace</code>
      </div>
    </section>

    <section class="td-workflow td-wrap" id="workflow" aria-labelledby="workflow-title">
      <header class="td-section-head">
        <h2 id="workflow-title">Marketplaces are for discovery.<br /><span>Skilldrop is for handoff.</span></h2>
        <div><p>skills.sh and GitHub help you publish reusable skills. Skilldrop handles the moment before that: sending one working local skill to one teammate without creating a repository.</p><code>01 / local → link → teammate</code></div>
      </header>

      <div class="td-command-list">
        <article>
          <div class="td-command-title"><span>01</span><h3>Share it where it lives.</h3></div>
          <p>Run <code>sk share</code> on any folder with a <code>SKILL.md</code>.</p>
          <div class="td-mini-command"><code><span>$</span> sk share ./review-pr</code><button data-copy="sk share ./review-pr" aria-label="Copy share example">copy</button></div>
        </article>
        <article>
          <div class="td-command-title"><span>02</span><h3>Review the exact snapshot.</h3></div>
          <p>See every file, checksum, executable, and the exact expiration time.</p>
          <div class="td-mini-command"><code><span>$</span> sk inspect PL1mY4-</code><button data-copy="sk inspect PL1mY4-" aria-label="Copy inspect example">copy</button></div>
        </article>
        <article>
          <div class="td-command-title"><span>03</span><h3>Install it for your agent.</h3></div>
          <p>One command for Claude Code, Codex, or the agent you already use.</p>
          <div class="td-mini-command"><code><span>$</span> sk install PL1mY4- --agent codex</code><button data-copy="sk install PL1mY4- --agent codex" aria-label="Copy install example">copy</button></div>
        </article>
      </div>
    </section>

    <section class="td-inspect td-wrap" id="inspect" aria-labelledby="inspect-title">
      <div class="td-inspect-copy">
        <span class="td-section-index">02 / inspect first</span>
        <h2 id="inspect-title">The contents are the interface.</h2>
        <p>No trust badge can replace seeing what is inside. <code>sk inspect</code> verifies the archive and prints the evidence without extracting or executing it.</p>
        <a href="/security/">Read the security model <span aria-hidden="true">→</span></a>
      </div>
      <div class="td-frame">
        <figure class="td-surface td-inspect-output">
          <figcaption class="td-chrome">
            <span class="td-tab">inspect · output</span>
            <button type="button" class="td-icon-button" data-copy={inspectCommand} aria-label="Copy inspect command">
              <svg class="td-copy-icon" viewBox="0 0 18 18" aria-hidden="true"><rect x="6" y="5" width="8" height="9"></rect><path d="M4 11H3V3h8v1"></path></svg>
              <svg class="td-check-icon" viewBox="0 0 18 18" aria-hidden="true"><path d="m3.5 9 3.3 3.3 7.7-7.6"></path></svg>
            </button>
          </figcaption>
          <div class="td-manifest">
            <div class="td-manifest-lead"><div><span>snapshot</span><strong>review-pr</strong></div><span class="td-verified">✓ verified</span></div>
            <dl>
              <div><dt>snapshot id</dt><dd>PL1mY4-</dd></div>
              <div><dt>protocol</dt><dd>1</dd></div>
              <div><dt>bundle</dt><dd>4.9 KiB · 5018 bytes</dd></div>
              <div><dt>bundle sha256</dt><dd>5af18c2…</dd></div>
              <div><dt>expires</dt><dd>Aug 29 · 14:32 UTC</dd></div>
              <div><dt>visibility</dt><dd>unlisted, not private</dd></div>
              <div><dt>files</dt><dd>2</dd></div>
              <div><dt>executables</dt><dd>none</dd></div>
            </dl>
            <div class="td-file-tree">
              <p><span>review-pr/</span><small>sha256</small></p>
              <p><span>├─ SKILL.md</span><small>9cf2…41b8</small></p>
              <p><span>└─ references/checklist.md</span><small>01aa…7e0f</small></p>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <section class="td-agents" aria-labelledby="agents-title">
      <div class="td-wrap">
        <header class="td-section-head">
          <h2 id="agents-title">Install once.<br /><span>Target the agents you use.</span></h2>
          <div><p>Skilldrop detects local agent directories, installs one canonical copy, and links compatible targets by default.</p><code>03 / destinations</code></div>
        </header>
        <div class="td-agent-matrix">
          {agents.map((agent, index) => <div><span>{String(index + 1).padStart(2, "0")}</span><strong>{agent}</strong><code>ready</code></div>)}
          <div class="td-agent-universal"><span>09</span><strong>Universal</strong><code>.agents/skills</code></div>
        </div>
      </div>
    </section>

    <section class="td-specs td-wrap" aria-labelledby="specs-title">
      <div class="td-specs-title">
        <span class="td-section-index">04 / boundary</span>
        <h2 id="specs-title">A transfer layer.<br /><span>Not a marketplace.</span></h2>
      </div>
      <table>
        <thead><tr><th>Property</th><th>Skilldrop</th><th>Why it matters</th></tr></thead>
        <tbody>
          <tr><th>Identity</th><td>no account</td><td>Share directly from the terminal.</td></tr>
          <tr><th>Storage</th><td>immutable for 7 days</td><td>The artifact cannot change under the same link and is deleted after expiry.</td></tr>
          <tr><th>Visibility</th><td>unlisted, not private</td><td>Anyone with the transfer link can retrieve the snapshot.</td></tr>
          <tr><th>Inspection</th><td>before extraction</td><td>Review paths, modes, checksums, and executables first.</td></tr>
          <tr><th>Execution</th><td>never automatic</td><td>Skill scripts are transferred, not run.</td></tr>
          <tr><th>Source control</th><td>not required</td><td>Useful local work can move without becoming a repository.</td></tr>
        </tbody>
      </table>
    </section>

    <section class="td-install td-wrap" id="install" aria-labelledby="install-title">
      <div class="td-install-heading">
        <span class="td-section-index">05 / get sk</span>
        <h2 id="install-title">The next time a teammate asks<br /><span>“can you send me that skill?”, send a link.</span></h2>
        <p>Install Skilldrop, then run <code>sk share</code> from any skill directory.</p>
      </div>
      <div class="td-install-panel">
        <div class="td-install-tabs" role="tablist" aria-label="Installation method">
          {installMethods.map((method, index) => (
            <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} data-install-tab data-command={method.command}>{method.label}</button>
          ))}
        </div>
        <div class="td-install-command" role="tabpanel">
          <span class="td-prompt" aria-hidden="true">$</span><code data-install-code>{installCommand}</code>
          <button type="button" data-copy={installCommand} data-install-copy data-s-event="install_command_copy" data-s-event-props="command_variant=script"><span>Install Skilldrop</span><b aria-hidden="true">✓ Copied</b></button>
        </div>
        <div class="td-install-links"><a href="https://getsk.dev/install.sh">view script</a><a href="/docs/">quick start →</a></div>
      </div>
    </section>
  </main>

  <footer class="td-footer">
    <div class="td-wrap td-footer-grid">
      <div><a class="td-brand" href="/"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5.5 9.5h21v16h-21z"></path><path d="M16 3.5v14m0 0 5-5m-5 5-5-5"></path></svg><span>skilldrop</span></a><p>Move skills, not setup instructions.</p></div>
      <nav aria-label="Documentation"><strong>Product</strong><a href="/docs/">Docs</a><a href="/cli/">CLI reference</a><a href="/security/">Security</a></nav>
      <nav aria-label="Project"><strong>Project</strong><a href="https://github.com/skilldrophq/skilldrop">GitHub</a><a href="https://github.com/skilldrophq/skilldrop/blob/main/LICENSE">Apache-2.0</a></nav>
      <div class="td-footer-meta"><span>skilldrop.dev</span><span>© {new Date().getFullYear()}</span><code>exit 0</code></div>
    </div>
  </footer>

  <div class="td-toast" role="status" aria-live="polite">Copied to clipboard</div>

  <script>
    const analyticsWindow = window as typeof window & { stonks?: { event: (name: string, props?: Record<string, string>) => void } };
    window.addEventListener("load", () => analyticsWindow.stonks?.event("landing_view", { landing_variant: "handoff_v1" }), { once: true });

    const installTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-install-tab]"));
    const installCode = document.querySelector<HTMLElement>("[data-install-code]");
    const installCopy = document.querySelector<HTMLButtonElement>("[data-install-copy]");

    const selectInstallMethod = (tab: HTMLButtonElement) => {
      const command = tab.dataset.command;
      if (!command) return;
      installTabs.forEach((item) => {
        const selected = item === tab;
        item.setAttribute("aria-selected", String(selected));
        item.tabIndex = selected ? 0 : -1;
      });
      if (installCode) installCode.textContent = command;
      if (installCopy) installCopy.dataset.copy = command;
    };

    installTabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectInstallMethod(tab));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const next = installTabs[(index + (event.key === "ArrowRight" ? 1 : -1) + installTabs.length) % installTabs.length];
        if (next) { selectInstallMethod(next); next.focus(); }
      });
    });

    const toast = document.querySelector<HTMLElement>(".td-toast");
    let toastTimeout: number | undefined;
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const value = button.dataset.copy;
        if (!value) return;
        try {
          await navigator.clipboard.writeText(value);
          button.classList.add("is-copied");
          toast?.classList.add("is-visible");
          window.clearTimeout(toastTimeout);
          toastTimeout = window.setTimeout(() => toast?.classList.remove("is-visible"), 1600);
          window.setTimeout(() => button.classList.remove("is-copied"), 1600);
        } catch { window.prompt("Copy this command:", value); }
      });
    });
  </script>
</BaseLayout>
