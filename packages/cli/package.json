{
  "name": "@skilldrophq/cli",
  "version": "0.0.3",
  "description": "Share and install agent skills with Skilldrop",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skilldrophq/skilldrop.git",
    "directory": "packages/cli"
  },
  "bin": {
    "sk": "dist/sk.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun build src/main.ts --target=node --outfile=dist/sk.js --banner='#!/usr/bin/env node' --minify",
    "check": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --severity error",
    "dev": "SKILLDROP_DEV=true bun run src/main.ts",
    "test": "bun test",
    "prepack": "bun run check && bun run test && bun run build"
  },
  "devDependencies": {
    "@effect/platform-node": ">=4.0.0-beta.102 || >=4.0.0",
    "@effect/tsgo": "0.31.0",
    "@types/bun": "latest",
    "effect": ">=4.0.0-beta.102 || >=4.0.0",
    "typescript": "7.0.2"
  }
}
